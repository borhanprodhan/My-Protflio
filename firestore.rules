rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'mdborhprodhan@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidStringList(arr, maxItems, maxItemLen) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll([
          'name', 'title', 'location', 'email', 'phone', 'experienceSummary',
          'educationHsc', 'educationSsc', 'heroHeading', 'heroSubheading', 'introText',
          'aboutHeading', 'aboutBody', 'profilePhotoUrl', 'cvUrl', 'cvLabel',
          'footerTagline', 'footerSubtitle', 'seoTitle', 'seoDescription',
          'ogTitle', 'ogDescription', 'showHero', 'showAbout', 'showServices',
          'showSkills', 'showProjects', 'showContact', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'title', 'location', 'email', 'phone', 'experienceSummary',
          'educationHsc', 'educationSsc', 'heroHeading', 'heroSubheading', 'introText',
          'aboutHeading', 'aboutBody', 'profilePhotoUrl', 'cvUrl', 'cvLabel',
          'footerTagline', 'footerSubtitle', 'seoTitle', 'seoDescription',
          'ogTitle', 'ogDescription', 'showHero', 'showAbout', 'showServices',
          'showSkills', 'showProjects', 'showContact', 'updatedAt'
        ])
        && isValidString(data.name, 2, 120)
        && isValidString(data.title, 2, 160)
        && isValidString(data.location, 2, 160)
        && isValidString(data.email, 5, 160)
        && isValidString(data.phone, 5, 40)
        && isValidString(data.experienceSummary, 2, 160)
        && isValidOptionalString(data.educationHsc, 100)
        && isValidOptionalString(data.educationSsc, 100)
        && isValidString(data.heroHeading, 5, 220)
        && isValidString(data.heroSubheading, 5, 400)
        && isValidString(data.introText, 5, 400)
        && isValidString(data.aboutHeading, 2, 160)
        && isValidString(data.aboutBody, 10, 2500)
        && isValidOptionalString(data.profilePhotoUrl, 500)
        && isValidOptionalString(data.cvUrl, 500)
        && isValidOptionalString(data.cvLabel, 80)
        && isValidOptionalString(data.footerTagline, 200)
        && isValidOptionalString(data.footerSubtitle, 200)
        && isValidOptionalString(data.seoTitle, 120)
        && isValidOptionalString(data.seoDescription, 300)
        && isValidOptionalString(data.ogTitle, 120)
        && isValidOptionalString(data.ogDescription, 300)
        && data.showHero is bool
        && data.showAbout is bool
        && data.showServices is bool
        && data.showSkills is bool
        && data.showProjects is bool
        && data.showContact is bool
        && data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
          'title', 'slug', 'shortDescription', 'fullDescription',
          'deliverables', 'visualUrl', 'order', 'visible', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'slug', 'shortDescription', 'fullDescription',
          'deliverables', 'visualUrl', 'order', 'visible', 'updatedAt'
        ])
        && isValidString(data.title, 2, 120)
        && isValidString(data.slug, 2, 120)
        && data.slug.matches('^[a-z0-9-]+$')
        && isValidString(data.shortDescription, 10, 400)
        && isValidString(data.fullDescription, 10, 2000)
        && isValidStringList(data.deliverables, 10, 140)
        && isValidOptionalString(data.visualUrl, 500)
        && data.order is number
        && data.visible is bool
        && data.updatedAt is timestamp;
    }

    function isValidSkill(data) {
      return data.keys().hasAll(['name', 'category', 'description', 'order', 'visible', 'updatedAt'])
        && data.keys().hasOnly(['name', 'category', 'description', 'order', 'visible', 'updatedAt'])
        && isValidString(data.name, 2, 100)
        && isValidString(data.category, 2, 80)
        && isValidString(data.description, 5, 300)
        && data.order is number
        && data.visible is bool
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'title', 'slug', 'category', 'description', 'coverImage',
          'gallery', 'technologies', 'projectUrl', 'githubUrl',
          'status', 'featured', 'published', 'order', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'slug', 'category', 'description', 'coverImage',
          'gallery', 'technologies', 'projectUrl', 'githubUrl',
          'status', 'featured', 'published', 'order', 'createdAt', 'updatedAt'
        ])
        && isValidString(data.title, 2, 140)
        && isValidString(data.slug, 2, 140)
        && data.slug.matches('^[a-z0-9-]+$')
        && isValidString(data.category, 2, 100)
        && isValidString(data.description, 10, 2500)
        && isValidOptionalString(data.coverImage, 500)
        && isValidStringList(data.gallery, 8, 500)
        && isValidStringList(data.technologies, 12, 60)
        && isValidOptionalString(data.projectUrl, 500)
        && isValidOptionalString(data.githubUrl, 500)
        && data.status in ['Architecture Blueprint', 'In Development', 'Published']
        && data.featured is bool
        && data.published is bool
        && data.order is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLanguage(data) {
      return data.keys().hasAll(['name', 'proficiency', 'order', 'visible'])
        && data.keys().hasOnly(['name', 'proficiency', 'order', 'visible'])
        && isValidString(data.name, 2, 60)
        && isValidOptionalString(data.proficiency, 80)
        && data.order is number
        && data.visible is bool;
    }

    function isValidSocialLink(data) {
      return data.keys().hasAll(['platform', 'label', 'url', 'order', 'visible'])
        && data.keys().hasOnly(['platform', 'label', 'url', 'order', 'visible'])
        && isValidString(data.platform, 2, 60)
        && isValidString(data.label, 2, 80)
        && isValidOptionalString(data.url, 500)
        && data.order is number
        && data.visible is bool;
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['title', 'url', 'mimeType', 'sizeBytes', 'uploadedAt'])
        && data.keys().hasOnly(['title', 'url', 'mimeType', 'sizeBytes', 'uploadedAt'])
        && isValidString(data.title, 1, 140)
        && isValidString(data.url, 1, 500)
        && isValidString(data.mimeType, 3, 100)
        && data.sizeBytes is number
        && data.sizeBytes >= 0
        && data.sizeBytes <= 10485760
        && data.uploadedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll([
          'fullName', 'email', 'phone', 'companyName', 'serviceRequired',
          'projectBudget', 'message', 'status', 'submittedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fullName', 'email', 'phone', 'companyName', 'serviceRequired',
          'projectBudget', 'message', 'status', 'submittedAt', 'updatedAt'
        ])
        && isValidString(data.fullName, 2, 120)
        && isValidString(data.email, 5, 160)
        && isValidString(data.phone, 5, 40)
        && isValidOptionalString(data.companyName, 140)
        && isValidString(data.serviceRequired, 2, 120)
        && isValidOptionalString(data.projectBudget, 100)
        && isValidString(data.message, 10, 3000)
        && data.status in ['New', 'Contacted', 'In Progress', 'Completed', 'Archived']
        && data.submittedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && isValidString(data.email, 5, 160)
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    match /site_content/{docId} {
      allow get: if isValidId(docId);
      allow list: if resource.data.showHero is bool;
      allow create: if isAdmin() && isValidId(docId) && isValidSiteContent(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(docId) && isValidSiteContent(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (existing().visible == true || isAdmin());
      allow list: if resource.data.visible == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(serviceId) && isValidService(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(serviceId) && isValidService(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    match /skills/{skillId} {
      allow get: if isValidId(skillId) && (existing().visible == true || isAdmin());
      allow list: if resource.data.visible == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(skillId) && isValidSkill(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(skillId) && isValidSkill(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(skillId);
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(projectId);
    }

    match /languages/{languageId} {
      allow get: if isValidId(languageId) && (existing().visible == true || isAdmin());
      allow list: if resource.data.visible == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(languageId) && isValidLanguage(incoming());
      allow update: if isAdmin() && isValidId(languageId) && isValidLanguage(incoming());
      allow delete: if isAdmin() && isValidId(languageId);
    }

    match /social_links/{linkId} {
      allow get: if isValidId(linkId) && (existing().visible == true || isAdmin());
      allow list: if resource.data.visible == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(linkId) && isValidSocialLink(incoming());
      allow update: if isAdmin() && isValidId(linkId) && isValidSocialLink(incoming());
      allow delete: if isAdmin() && isValidId(linkId);
    }

    match /media/{mediaId} {
      allow get: if isAdmin() && isValidId(mediaId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(mediaId) && isValidMedia(incoming()) && incoming().uploadedAt == request.time;
      allow update: if isAdmin() && isValidId(mediaId) && isValidMedia(incoming()) && incoming().uploadedAt == existing().uploadedAt;
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    match /contact_messages/{messageId} {
      allow get: if isAdmin() && isValidId(messageId);
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(messageId) && isValidContactMessage(incoming()) && incoming().status == 'New' && incoming().submittedAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(messageId) && isValidContactMessage(incoming()) && incoming().submittedAt == existing().submittedAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(messageId);
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminUser(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }
  }
}
